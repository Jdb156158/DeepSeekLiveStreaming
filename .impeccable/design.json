  "components": [
    {
      "name": "小院主操作",
      "kind": "button",
      "description": "珊瑚色提交操作。",
      "html": "<button class=\"ds-garden-primary\">推一下</button>",
      "css": ".ds-garden-primary{font:550 14px -apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;background:#b5543c;color:#fffef7;padding:11px 14px;border:0;border-radius:11px;cursor:pointer;transition:background .16s,color .16s}.ds-garden-primary:hover{background:#91412f}.ds-garden-primary:focus-visible{outline:3px solid #9a583d;outline-offset:3px}",
      "refersTo": "garden-button-primary"
    },
    {
      "name": "小院次操作",
      "kind": "button",
      "description": "声音、暂停与重置。",
      "html": "<button class=\"ds-garden-secondary\">暂停</button>",
      "css": ".ds-garden-secondary{font:550 14px -apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;background:#e6eddc;color:#506449;padding:10px 15px;border:0;border-radius:11px;cursor:pointer;transition:background .16s,color .16s}.ds-garden-secondary:hover{background:#d8e4c9}.ds-garden-secondary:focus-visible{outline:3px solid #9a583d;outline-offset:3px}",
      "refersTo": "garden-button-secondary"
    },
    {
      "name": "小院命令输入",
      "kind": "input",
      "description": "和提交按钮并排的单行命令框。",
      "html": "<div class=\"ds-command\"><input aria-label=\"模拟弹幕\" placeholder=\"想推几号呀？\"></div>",
      "css": ".ds-command{display:flex;gap:8px}.ds-command input{width:0;min-width:0;flex:1;font:14px -apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;color:#4e5745;background:#fffefa;border:1px solid #d5d7c3;border-radius:10px;padding:11px 10px;caret-color:#b5543c}.ds-command input::placeholder{color:#737864}.ds-command input:focus-visible{outline:3px solid #9a583d;outline-offset:3px}",
      "refersTo": "garden-command-field"
    },
    {
      "name": "六排号码按钮",
      "kind": "button",
      "description": "号码、颜色、动作和状态共同识别砖排。",
      "html": "<button class=\"ds-lane\"><span class=\"ds-number\">1</span><span class=\"ds-label\">1号倒<small>已就位</small></span></button>",
      "css": ".ds-lane{min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;min-height:88px;padding:10px 5px;background:#f5f2e7;box-shadow:inset 0 -3px 0 #e7dfcc;border:0;border-radius:13px;color:#4d5847;cursor:pointer;transition:background .15s,transform .15s}.ds-lane:hover{background:#eee8d7;transform:translateY(-2px)}.ds-lane:disabled{opacity:1;cursor:default;background:#efeee5;box-shadow:inset 0 -2px 0 #e4e3d7;transform:none}.ds-number{display:flex;align-items:center;justify-content:center;width:31px;height:34px;border-radius:7px;background:#ef947e;color:#443e38;font:400 23px \"Garden Happy\",sans-serif;box-shadow:inset -3px -3px 0 #0000000c,inset 2px 2px 0 #ffffff55}.ds-label{font:550 12px -apple-system,\"PingFang SC\",sans-serif;text-align:center}.ds-label small{display:block;white-space:nowrap;margin-top:3px;font-size:11px;font-weight:400;line-height:1.3;color:#68725e}.ds-lane:focus-visible{outline:3px solid #9a583d;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-lane{transition:none}.ds-lane:hover{transform:none}}"
    },
    {
      "name": "小院状态标签",
      "kind": "chip",
      "description": "显示参与方式或真实工作阶段。",
      "html": "<span class=\"ds-tag\">待命中</span>",
      "css": ".ds-tag{display:inline-block;background:#eef1df;color:#65714e;font:11px -apple-system,\"PingFang SC\",sans-serif;padding:5px 8px;border-radius:6px}"
    },
    {
      "name": "小院操作面板",
      "kind": "card",
      "description": "主操作、工作状态及帮助的共享纸色容器。",
      "html": "<aside class=\"ds-panel\"><h2>本鱼的扶砖日记</h2><p>今天的砖，还一块都没倒。</p></aside>",
      "css": ".ds-panel{background:#fffdf6;color:#4e5745;box-shadow:0 6px 22px #545c3d0a;border-radius:20px;padding:25px 23px;min-width:0}.ds-panel h2{font:400 20px/1.3 \"Garden Happy\",sans-serif;margin:0}.ds-panel p{font:13px/1.65 -apple-system,\"PingFang SC\",sans-serif;color:#5e6b52;margin:14px 0 15px}",
